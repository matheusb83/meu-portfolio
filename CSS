
/* Estilo geral */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #10131d;
    color: #f5f5f5;
    line-height: 1.6;
}

/* Menu */
header {
    background-color: #171b28;
    padding: 18px 8%;
}

.menu {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 26px;
}

.logo span,
.inicio h1 span {
    color: #a855f7;
}

.menu ul {
    display: flex;
    list-style: none;
    gap: 22px;
}

.menu a {
    color: #eeeeee;
    text-decoration: none;
    font-size: 14px;
}

.menu a:hover {
    color: #a855f7;
}

/* Início */
.inicio {
    min-height: 520px;
    padding: 80px 10%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
}

.inicio-texto {
    max-width: 620px;
}

.destaque {
    color: #a855f7;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.inicio h1 {
    font-size: 42px;
    margin-bottom: 8px;
}

.inicio h2 {
    font-size: 21px;
    color: #c7c7d1;
    margin-bottom: 18px;
}

.inicio-texto > p:not(.destaque) {
    color: #b8bac7;
    margin-bottom: 28px;
}

.botao {
    display: inline-block;
    background-color: #a855f7;
    color: white;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 6px;
}

.botao:hover {
    background-color: #9138df;
}

.foto {
    width: 230px;
    height: 230px;
    border: 3px solid #a855f7;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #202638;
    flex-shrink: 0;
}

.letra {
    font-size: 100px;
    color: #a855f7;
    font-weight: bold;
}

/* Seções */
.secao {
    padding: 65px 10%;
    text-align: center;
}

.fundo {
    background-color: #171b28;
}

.titulo {
    font-size: 30px;
    margin-bottom: 12px;
}

.titulo::after {
    content: "";
    display: block;
    width: 55px;
    height: 3px;
    background-color: #a855f7;
    margin: 10px auto 25px;
}

.texto-sobre {
    max-width: 750px;
    margin: auto;
    color: #c1c3ce;
}

.subtitulo {
    color: #b8bac7;
    margin-bottom: 30px;
}

/* Habilidades */
.habilidades-lista {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
}

.habilidade {
    background-color: #22283a;
    padding: 22px;
    width: 190px;
    border-radius: 8px;
    border: 1px solid #343b50;
}

.habilidade h3 {
    color: #c084fc;
    margin-bottom: 8px;
}

.habilidade p {
    color: #c1c3ce;
    font-size: 14px;
}

/* Projetos */
.projetos-lista {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 30px;
}

.projeto {
    background-color: #171b28;
    border: 1px solid #343b50;
    border-radius: 8px;
    padding: 25px;
    width: 280px;
    text-align: left;
}

.numero {
    color: #a855f7;
    font-weight: bold;
}

.projeto h3 {
    margin: 12px 0;
}

.projeto p {
    color: #c1c3ce;
    font-size: 14px;
}

.projeto .tecnologias {
    color: #c084fc;
    margin-top: 18px;
}

/* Contato */
.contato p {
    color: #c1c3ce;
}

.links-contato {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 25px;
}

.links-contato a {
    color: white;
    background-color: #a855f7;
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 5px;
}

.links-contato a:hover {
    background-color: #9138df;
}

/* Rodapé */
footer {
    background-color: #10131d;
    color: #999cab;
    text-align: center;
    padding: 18px;
    font-size: 13px;
}

/* Celulares */
@media (max-width: 700px) {

    .menu {
        flex-direction: column;
        gap: 15px;
    }

    .menu ul {
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    .inicio {
        flex-direction: column-reverse;
        text-align: center;
        padding-top: 55px;
    }

    .inicio h1 {
        font-size: 32px;
    }

    .foto {
        width: 170px;
        height: 170px;
    }

    .letra {
        font-size: 75px;
    }

    .links-contato {
        flex-wrap: wrap;
    }
}
